# Bind to all interfaces so trusted tailnet devices can use the local Vite proxy.
# This also exposes the API to other reachable LAN interfaces; use only on trusted networks.
API_HOST=0.0.0.0
API_PORT=4100
API_DATA_DIR=./data
API_UPLOAD_DIR=./uploads
API_MAX_UPLOAD_MB=4096
# Maximum request-body receipt time; 4 hours default for large files over a slower local link.
# Accepted range: 60000–86400000 ms. Node's header timeout remains 60 seconds.
API_UPLOAD_TIMEOUT_MS=14400000

# Optional extra Vite hostnames, comma-separated. Example: your-device.example.ts.net
# WEB_ALLOWED_HOSTS=your-device.example.ts.net

# Optional Python worker command. Leave empty to run safely without analysis.
# On macOS, npm run setup:mac creates a local profile in a fresh .env.
VISION_PYTHON=
VISION_WORKER_SCRIPT=apps/vision/worker.py
VISION_MODEL_PATH=
# YOLO26 only: auto selects CUDA/MPS when available, otherwise CPU. Use cpu to force CPU.
# VISION_DEVICE=cpu

# Optional staged RF-DETR Medium CUDA candidate. Leave these commented until
# the local RF-DETR benchmark is accepted; the normal worker remains ONNX/CPU.
# VISION_PYTHON=apps/vision/.venv-rfdetr/Scripts/python.exe
# VISION_MODEL_PATH=apps/vision/models/rfdetr/rf-detr-medium.pth
# VISION_DETECTOR_BACKEND=rfdetr
# VISION_DETECTOR_SIZE=medium
# HF_HOME=apps/vision/.cache/huggingface
# TORCH_HOME=apps/vision/.cache/torch
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# To evaluate the larger current model instead, run setup-rfdetr.ps1 -IncludeLarge,
# then set VISION_MODEL_PATH=apps/vision/models/rfdetr/rf-detr-large-2026.pth
# and VISION_DETECTOR_SIZE=large.
# Optional isolated YOLO26 Medium candidate (Ultralytics AGPL-3.0 package/model).
# Windows setup: apps/vision/setup-yolo26.ps1. macOS setup: npm run setup:mac.
# The Mac setup enables YOLO26 on Apple Silicon and the ONNX CPU fallback on Intel.
# VISION_PYTHON=apps/vision/.venv-yolo26/Scripts/python.exe
# VISION_MODEL_PATH=apps/vision/models/yolo26/yolo26m.pt
# VISION_DETECTOR_BACKEND=yolo26
# VISION_DETECTOR_SIZE=medium
# VISION_INPUT_SIZE=1280
# VISION_YOLO_NMS=true
# YOLO_CONFIG_DIR=apps/vision/.tmp/yolo-config

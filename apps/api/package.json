  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
